FROM ubuntu:22.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gnupg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Packaging moved to the XRPL Foundation in August 2026: repos.ripple.com still answers but
# its nightly channel stopped receiving builds on 2026-09-15 and never got 3.4.0, so a stand
# pinned there tracks a frozen snapshot while reporting itself current. docs/install.md in
# rippled names packages.xrplf.org as the only source. apt reads the armoured key as it is,
# so there is no dearmour step.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://packages.xrplf.org/xrplf.asc -o /etc/apt/keyrings/xrplf.asc

# rippled was renamed to xrpld on develop and the package keeps that name. The channel is
# deb-develop - every push to develop - and its suite is "any main", not a distribution name.
#
# The version is pinned so the stand is reproducible, and so the amendment lists in
# rippled.batchv11.cfg can be generated from the very commit this binary was built from: the
# binary rejects feature names it does not know. bump-nightly-pin.sh keeps the two together by
# reading the commit out of the version string.
ARG XRPLD_VERSION=3.5.0~b0-1187.20260921git0229c29
RUN echo "deb [signed-by=/etc/apt/keyrings/xrplf.asc] https://packages.xrplf.org/repository/deb-develop any main" > /etc/apt/sources.list.d/xrplf.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends --allow-downgrades "xrpld=${XRPLD_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

# The xrpld deb package may already create the service user; keep this idempotent
RUN id -u xrpld >/dev/null 2>&1 || useradd --system --home-dir /var/lib/rippled --create-home --shell /usr/sbin/nologin xrpld; \
    mkdir -p /var/lib/rippled/db \
    && chown -R xrpld:xrpld /var/lib/rippled

EXPOSE 5005 5006 6006

USER xrpld
ENTRYPOINT ["/bin/sh", "-c", "exec \"$(command -v xrpld || command -v rippled || echo /opt/ripple/bin/rippled)\" --conf /config/rippled.cfg \"$@\"", "--"]
CMD ["-a", "--start"]
